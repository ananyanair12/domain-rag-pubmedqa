# Copy this file to .env and fill in your keys. Never commit the real .env.

# Groq API key (free tier) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model used for generation via Groq
GROQ_MODEL=llama-3.1-70b-versatile

# Baseline (off-the-shelf) embedding model
BASELINE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Where the fine-tuned embedding model gets saved / loaded from
FINETUNED_EMBEDDING_PATH=./models/finetuned-embedder-pubmedqa

# Chunk size selected as "best" after the ablation study (256 | 512 | 1024)
SELECTED_CHUNK_SIZE=512

# Vector store backend: "chroma" or "qdrant"
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./chroma_store

# Reranker model (cross-encoder)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
